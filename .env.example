# Required: Telegram token from BotFather; do not commit .env.
ECHO_BOT_TOKEN=
# Paste the PostgreSQL connection string supplied by your database provider.
ECHO_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
ECHO_BRAND=Echo
ECHO_ADMINS=
ECHO_TIMEZONE=Europe/Moscow
ECHO_AI_ENABLED=false
ECHO_AI_INTENTS=false
# DeepSeek API token; provider settings are already built in.
ECHO_AI_KEY=
ECHO_AI_DAILY_REQUESTS=300
ECHO_AI_USER_DAILY_REQUESTS=30
ECHO_AI_DAILY_BUDGET_USD=1
# Both prices are USD per million tokens; copy current official prices yourself.
# Leave all three unset to enforce request/output limits without currency accounting.
# ECHO_AI_INPUT_USD_MILLION=
# ECHO_AI_OUTPUT_USD_MILLION=
# ECHO_AI_PRICE_DATE=YYYY-MM-DD
ECHO_RESULT_TTL_HOURS=6
ECHO_HISTORY_TTL_DAYS=30
ECHO_GLOBAL_ACTIVE_JOBS=1
ECHO_USER_ACTIVE_JOBS=1
ECHO_GLOBAL_QUEUED_JOBS=100
ECHO_USER_DAILY_JOBS=20
ECHO_MAX_SITES=500
ECHO_SITE_TIMEOUT=15
ECHO_ENGINE_TIMEOUT=900
ECHO_DOMAIN_INTERVAL=1
ECHO_RESOURCE_PROFILE=eco
ECHO_HEAVY_SLOTS=1
ECHO_SEQUENTIAL_ENGINES=true
ECHO_METADATA_ENABLED=true
ECHO_OCR_ENABLED=true
ECHO_QR_ENABLED=true
ECHO_PASSPORT_ENABLED=true
ECHO_PAGE_ENABLED=true
ECHO_DOMAINS_ENABLED=true
ECHO_FILE_MAX_MB=10
ECHO_IMAGE_MAX_PIXELS=8000000
ECHO_OCR_THREADS=1
ECHO_DOMAIN_VARIANTS=25
ECHO_DOMAIN_DNS_QUERIES=50
ECHO_NET_CONNECTIONS=2
ECHO_NET_RESPONSE_BYTES=1000000
ECHO_DISK_QUOTA_MB=256
ECHO_USER_DISK_QUOTA_MB=64
ECHO_DISK_MIN_FREE_MB=64
ECHO_SCRATCH_QUOTA_MB=64
ECHO_FOLDER_TTL_DAYS=30
ECHO_EXPORT_MAX_MB=40
ECHO_BRAND_IMAGES=true
ECHO_RECENT_RESULT_MINUTES=30
ECHO_BATCH_MAX_CARDS=50
